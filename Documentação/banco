SELECT
    m.id,
    u.nome AS usuario,
    e.nome AS equipamento,
    m.tipo,
    m.quantidade,
    m.data_movimentacao
FROM movimentacoes m
JOIN usuarios u
    ON m.usuario_id = u.id
JOIN equipamentos e
    ON m.equipamento_id = e.id;
