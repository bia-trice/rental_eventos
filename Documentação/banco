CREATE TABLE equipamentos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    marca VARCHAR(50),
    modelo VARCHAR(50),
    categoria VARCHAR(50) NOT NULL,
    potencia VARCHAR(30),
    material VARCHAR(50),
    peso DECIMAL(8,2),
    dimensoes VARCHAR(50),
    cor VARCHAR(30),
    quantidade INT NOT NULL,
    estoque_minimo INT NOT NULL
);

